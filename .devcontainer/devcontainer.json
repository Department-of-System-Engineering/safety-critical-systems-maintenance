{
  "name": "Safety-Critical Systems Course",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {}
  },
  "postCreateCommand": "python -m pip install -e '.[dev]'",
  "postStartCommand": "bash .devcontainer/start-preview.sh",
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Quarto course preview",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
